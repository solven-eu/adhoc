<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>eu.solven.adhoc</groupId>
		<artifactId>aggregator-adhoc</artifactId>
		<version>0.1.1-SNAPSHOT</version>
	</parent>

	<artifactId>adhoc-aggregate</artifactId>
	<!-- `name` is required by Sonatype-->
	<name>${project.groupId}:${project.artifactId}</name>

	<properties>
		<!-- skip tests else JUnit complains not to find any-->
		<maven.test.skip>true</maven.test.skip>
		<maven.install.skip>true</maven.install.skip>
		<maven.deploy.skip>true</maven.deploy.skip>
		<skipPublishing>true</skipPublishing>

		<jacoco.branch.ratio>0.78</jacoco.branch.ratio>
		<jacoco.instruction.ratio>0.84</jacoco.instruction.ratio>
		<automatic.module.name>eu.solven.adhoc.aggregate</automatic.module.name>
	</properties>

	<dependencies>
		<!--
			`jacoco:report-aggregate` only walks DIRECT <dependency> entries (not transitive). Every source module
			whose coverage should appear in the merged report must be listed below. Build the report with:

				mvn jacoco:report-aggregate -pl :adhoc-aggregate -am

			The `-am` is required so each dependency module joins the current reactor — without it, JaCoCo cannot
			locate the per-module `target/jacoco.exec` files and the report comes out empty.

			IMPORTANT: when adding a new source module to the project, add it here too. A missing entry causes the
			aggregate to silently under-report coverage for classes whose tests live in another module — e.g.
			`engine/cube` tests covering `engine/table` classes. Listing every module is the difference between
			"trustworthy 70%" and "misleading 0%" in the merged report.
		-->
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-model</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-fsst</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-encoding</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-cell</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-calcite</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-filters</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-measures</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-dataframe</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-table</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-cube</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-recipes</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>adhoc-experimental</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>pivotable-model</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>pivotable-infra</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>pivotable-server-oauth2</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>pivotable-server-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>pivotable-server-webflux</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>pivotable-server</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>pivotable-mcp</artifactId>
			<version>${project.version}</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<!-- https://cylab.be/blog/97/compute-code-coverage-for-a-multi-module-maven-project-with-jacoco -->
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>report-aggregate</id>
						<goals>
							<goal>report-aggregate</goal>
						</goals>

						<phase>verify</phase>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
