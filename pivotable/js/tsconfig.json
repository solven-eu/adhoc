{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": false,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": false,
        "types": [
            "node",
            "vite/client"
        ],
        "paths": {
            "@/*": [
                "./src/main/resources/static/ui/*"
            ]
        }
    },
    "include": [
        "src/main/resources/static/ui/**/*.js",
        "unit-tests/**/*.js",
        "e2e-tests/**/*.js",
        "e2e-tests/**/*.mjs",
        "scripts/**/*.mjs",
        "types/**/*.d.ts",
        "vite.config.js",
        "vitest.config.js"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "playwright-report",
        "vitest-report",
        "coverage",
        "**/target/**"
    ]
}
