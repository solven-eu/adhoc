<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>eu.solven.adhoc</groupId>
		<artifactId>pivotable</artifactId>
		<version>0.1.1-SNAPSHOT</version>
	</parent>

	<artifactId>pivotable-mcp-webmvc</artifactId>
	<!-- `name` is required by Sonatype-->
	<name>${project.groupId}:${project.artifactId}</name>
	<description>WebMVC SSE transport bundle for the Pivotable MCP server. Pulls in `pivotable-mcp` (transport-agnostic tool definitions) and `spring-ai-starter-mcp-server-webmvc` (Spring AI's servlet MCP server starter). Sibling to `pivotable-mcp-webflux`; a WebMVC Pivotable server module depends on this one.</description>

	<!-- Default jar packaging: the module ships an (essentially empty) jar so consumers can depend on it with the
	     default <type>jar</type>. The value is in the transitive <dependencies>, not in classes. -->
	<properties>
		<!-- Workaround `groups/excludedGroups require TestNG, JUnit48+ or JUnit 5 (a specific engine required on classpath) on project test classpath`: this module has no test sources and pulls no JUnit Platform engine. -->
		<maven.test.skip>true</maven.test.skip>
		<automatic.module.name>eu.solven.adhoc.pivotable.mcp.webmvc</automatic.module.name>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>2.0.0-M8</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>eu.solven.adhoc</groupId>
			<artifactId>pivotable-mcp</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
		</dependency>
	</dependencies>
</project>
