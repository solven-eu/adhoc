<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <logger name="eu.solven.adhoc.deep.package" level="DEBUG"/>
 
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%-10.10thread]%-4.4level %-43.243(%class{40}\(%line\)) %msg%n</pattern>
        </encoder>
    </appender>
   
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
  
</configuration>